get_kde_values(data)\n                if len(x_range) > 0:\n                    # Plot KDE line\n                    ax.plot(x_range, y_values, color=color, linewidth=2, label=set_name, alpha=0.8)\n                    # Add fill under curve\n                    ax.fill_between(x_range, 0, y_values, alpha=0.2, color=color)\n                    \n                    # Add mean and median lines\n                    mean_val = data.mean()\n                    median_val = data.median()\n                    ax.axvline(mean_val, color=color, linestyle='--', alpha=0.5, linewidth=1)\n                    ax.axvline(median_val, color=color, linestyle=':', alpha=0.5, linewidth=1)\n        \n        # Add statistics box\n        stats_text = \"\"\n        for set_name in set_colors.keys():\n            data = df_plot[df_plot['Set'] == set_name][col].dropna()\n            if len(data) > 0:\n                stats_text += f\"{set_name[:3]}: μ={data.mean():.2f}, σ={data.std():.2f}\\n\"\n        \n        if stats_text:\n            ax.text(0.95, 0.95, stats_text, transform=ax.transAxes,\n                   fontsize=8, verticalalignment='top', horizontalalignment='right',\n                   bbox=dict(boxstyle='round', facecolor='white', alpha=0.7, edgecolor='gray'))\n        \n        ax.set_xlabel(col, fontsize=10, fontweight='bold')\n        ax.set_ylabel('Density', fontsize=9)\n        ax.set_title(f'Distribution of {col}', fontsize=11, fontweight='bold')\n        ax.grid(alpha=0.3, linestyle='--')\n        ax.legend(loc='upper right', fontsize=8)\n        \n    else:\n        # Categorical feature - Histogram plot\n        # Get unique values for the column\n        unique_vals = df_plot[col].dropna().unique()\n        n_unique = len(unique_vals)\n        \n        # Limit to top categories if too many\n        if n_unique > 15:\n            top_cats = df_plot[col].value_counts().head(15).index\n            df_plot_filtered = df_plot[df_plot[col].isin(top_cats)]\n            title_suffix = \" (Top 15)\"\n            categories = top_cats\n        else:\n            df_plot_filtered = df_plot\n            title_suffix = \"\"\n            categories = np.sort(unique_vals)\n        \n        # Grouped bar chart\n        x_pos = np.arange(len(categories))\n        width = 0.25\n        multiplier = 0\n        \n        for set_name, color in set_colors.items():\n            subset = df_plot_filtered[df_plot_filtered['Set'] == set_name]\n            counts = []\n            for cat in categories:\n                count = len(subset[subset[col] == cat])\n                counts.append(count)\n            \n            total = sum(counts)\n            proportions = [c/total if total > 0 else 0 for c in counts]\n            \n            offset = width * multiplier\n            bars = ax.bar(x_pos + offset, proportions, width, \n                         label=set_name, color=color, alpha=0.7, \n                         edgecolor='black', linewidth=0.5)\n            multiplier += 1\n            \n            # Add value labels on bars (only for first set to avoid clutter)\n            if set_name == 'Train':\n                for bar, prop in zip(bars, proportions):\n                    if prop > 0.01:  # Only show if > 1%\n                        ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01,\n                               f'{prop:.2f}', ha='center', va='bottom', fontsize=7, rotation=0)\n        \n        ax.set_xticks(x_pos + width)\n        ax.set_xticklabels(categories, rotation=45, ha='right', fontsize=8)\n        ax.set_xlabel(col, fontsize=10, fontweight='bold')\n        ax.set_ylabel('Proportion', fontsize=9)\n        ax.set_title(f'Distribution of {col}{title_suffix}', fontsize=11, fontweight='bold')\n        ax.grid(axis='y', alpha=0.3, linestyle='--')\n        ax.legend(loc='upper right', fontsize=8)\n        ax.set_ylim(0, max([ax.get_ylim()[1], 0.5]))\n\n# Remove any unused subplots\nfor idx in range(len(features_to_