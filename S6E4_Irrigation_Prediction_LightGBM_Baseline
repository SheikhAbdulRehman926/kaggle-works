'upper right', fontsize=10, frameon=True, fancybox=True)\nax3.grid(alpha=0.25, axis='y', linestyle='--', linewidth=0.8)\n\n# Add value labels\nfor bar in bars1:\n    height = bar.get_height()\n    ax3.text(bar.get_x() + bar.get_width()/2., height + 0.01,\n             f'{height:.1%}', ha='center', va='bottom', fontweight='bold', fontsize=9)\nfor bar in bars2:\n    height = bar.get_height()\n    ax3.text(bar.get_x() + bar.get_width()/2., height + 0.01,\n             f'{height:.1%}', ha='center', va='bottom', fontweight='bold', fontsize=9)\n\n# 4. Confusion Matrix Heatmap (bottom-left)\nax4 = fig.add_subplot(gs[1, 0])\ncm = confusion_matrix(y_encoded, oof_preds)\ncm_normalized = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]\n\nim = ax4.imshow(cm_normalized, interpolation='nearest', cmap='Blues')\nax4.set_xticks(range(len(target_le.classes_)))\nax4.set_yticks(range(len(target_le.classes_)))\nax4.set_xticklabels(target_le.classes_, fontsize=11, fontweight='bold')\nax4.set_yticklabels(target_le.classes_, fontsize=11, fontweight='bold')\nax4.set_xlabel('Predicted Label', fontsize=12, fontweight='bold', color='#2c3e50')\nax4.set_ylabel('True Label', fontsize=12, fontweight='bold', color='#2c3e50')\nax4.set_title('Confusion Matrix (Normalized)', fontsize=13, fontweight='bold', color='#1a5276')\n\n# Add text annotations\nfor i in range(len(target_le.classes_)):\n    for j in range(len(target_le.classes_)):\n        text = ax4.text(j, i, f'{cm_normalized[i, j]:.2%}\\n({cm[i, j]:,})',\n                       ha=\"center\", va=\"center\", color=\"white\" if cm_normalized[i, j] > 0.5 else \"black\",\n                       fontweight='bold', fontsize=9)\nplt.colorbar(im, ax=ax4, shrink=0.8)\n\n# 5. Feature Importance Top 15 (bottom-middle)\nax5 = fig.add_subplot(gs[1, 1])\ntop_15_features = feature_importance.head(15)\ny_pos = np.arange(len(top_15_features))\ncolors_importance = plt.cm.Blues(np.linspace(0.4, 0.9, 15))\nbars = ax5.barh(y_pos, top_15_features['Importance'].values, \n                color=colors_importance, edgecolor='#2c3e50', linewidth=0.8)\nax5.set_yticks(y_pos)\nax5.set_yticklabels(top_15_features['Feature'].values, fontsize=10)\nax5.set_xlabel('Importance Score', fontsize=12, fontweight='bold', color='#2c3e50')\nax5.set_title('Top 15 Feature Importance', fontsize=13, fontweight='bold', color='#1a5276')\nax5.invert_yaxis()\nax5.grid(alpha=0.25, axis='x', linestyle='--', linewidth=0.8)\n\n# Add value labels\ntotal_imp = feature_importance['Importance'].sum()\nfor i, (_, row) in enumerate(top_15_features.iterrows()):\n    pct = (row['Importance'] / total_imp) * 100\n    ax5.text(row['Importance'] + 50, i, f'{row[\"Importance\"]:,.0f} ({pct:.1f}%)', \n             va='center', fontsize=9, fontweight='bold')\n\n# 6. Performance Metrics Dashboard (bottom-right)\nax6 = fig.add_subplot(gs[1, 2])\nax6.axis('off')\n\n# Create metrics table\nmetrics_text = f\"\"\"\n╔══════════════════════════════════════════════════════════╗\n║              PERFORMANCE METRICS DASHBOARD               ║\n╠══════════════════════════════════════════════════════════╣\n║ CROSS-VALIDATION METRICS                                 ║\n║   • Mean Balanced Accuracy:     {mean_ba:.4f}                  ║\n║   • Std Deviation:              {std_ba:.4f}                  ║\n║   • Min Fold Score:             {min(fold_scores):.4f}                  ║\n║   • Max Fold Score:             {max(fold_scores):.4f}                  ║\n║                                                           ║\n║ PER-CLASS PERFORMANCE                                     ║\n║   • High Class Recall:          {class_recalls[0]:.2%}                  ║\n║   • Low Class Recall:           {class_recalls[1]:.2%}                  ║\n║   • Medium Class Recall:        {class_recalls[2]:.2%}                  ║\n║                                                           ║\n║ MODEL CONFIGURATION                                       ║\n║   • Estimators:                 {lgb_params['n_estimators']}                  ║\n║   • Learning Rate:              {lgb_params['learning_rate']}                  ║\n║   • Class Weight:               Balanced                  ║\n║   • Objective:                  Multiclass                ║\n║                                                           ║\n║ DATA CHARACTERISTICS                                      ║\n║   • Training Samples:           {len(X_train):,}              ║\n║   • Test Samples:               {len(X_test):,}              ║\n║   • Features:                   {len(X_train.columns)}                  ║\n║   • Classes:                    {len(target_le.classes_)}                    ║\n╚══════════════════════════════════════════════════════════╝\n\"\"\"\n\nax6.text(0.5, 0.5, metrics_text, transform=ax6.transAxes, fontsize=9,\n         verticalalignment='center', horizontalalignment='center',\n         fontfamily='monospace', bbox=dict(boxstyle=\"round,pad=0.5\", \n                                          facecolor='#f8f9fa', \n                                          edgecolor='#3498db', \n                                          linewidth=2))\n\n# Main title\nfig.suptitle('LightGBM Baseline Performance Dashboard', fontsize=18, fontweight='bold', \n             y=1.02, color='#1a5276')\nfig.patch.set_facecolor('#f8f9fa')\nplt.tight_layout()\nplt.show()\n\n# Print detailed insights\nprint(\"\\n\" + \"=\" * 80)\nprint(\"📊 DETAILED PERFORMANCE ANALYSIS\")\nprint(\"=\" * 80)\n\n# Calculate additional metrics\nfrom sklearn.metrics import precision_score, f1_score\n\nprecision_macro = precision_score(y_encoded, oof_preds, average='macro')\nf1_macro = f1_score(y_encoded, oof_preds, average='macro')\nprecision_weighted = precision_score(y_encoded, oof_preds, average='weighted')\nf1_weighted = f1_score(y_encoded, oof_preds, average='weighted')\n\nprint(f\"\\n🎯 AGGREGATE METRICS:\")\nprint(f\"   • Macro Precision: {precision_macro:.4f}\")\nprint(f\"   • Macro F1-Score: {f1_macro:.4f}\")\nprint(f\"   • Weighted Precision: {precision_weighted:.4f}\")\nprint(f\"   • Weighted F1-Score: {f1_weighted:.4f}\")\n\n# Per-class detailed metrics\nprint(f\"\\n📈 PER-CLASS DETAILED METRICS:\")\nprint(f\"{'Class':<12} {'Precision':<12} {'Recall':<12} {'F1-Score':<12} {'Support':<12}\")\nprint(\"-\" * 60)\nfor class_idx, class_name in enumerate(target_le.classes_):\n    mask_true = (y_encoded == class_idx)\n    mask_pred = (oof_preds == class_idx)\n    tp = ((y_encoded == class_idx) & (oof_preds == class_idx)).sum()\n    \n    precision = tp / mask_pred.sum() if mask_pred.sum() > 0 else 0\n    recall = tp / mask_true.sum() if mask_true.sum() > 0 else 0\n    f1 = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0\n    \n    print(f\"{class_name:<12} {precision:<12.4f} {recall:<12.4f} {f1:<12.4f} {mask_true.sum():<12,}\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"✅ SUCCESS METRICS\")\nprint(\"=\" * 80)\nprint(\"\"\"\n   ✓ Strong balanced accuracy across all folds (96.6% ± 0.1%)\n   ✓ Excellent recall for majority class (99.4%)\n   ✓ Good recall for minority classes (High: 93.1%, Medium: 97.3%)\n   ✓ Consistent performance across all 5 folds\n   ✓ Training and test distributions are well-aligned\n\"\"\")\n\nprint(\"=\" * 80)\nprint(\"⚠️ AREAS FOR IMPROVEMENT\")\nprint(\"=\" * 80)\nprint(\"\"\"\n   ⚠ High class recall could be improved further (93.1%)\n   ⚠ Some confusion between Medium and Low classes\n   ⚠ Feature importance shows opportunity for dimensionality reduction\n   ⚠ Consider addressing class imbalance with advanced techniques\n\"\"\")\n\nprint(\"=\" * 80)\nprint(\"💡 RECOMMENDATIONS FOR ENSEMBLE\")\nprint(\"=\" * 80)\nprint(\"\"\"\n   • Use OOF probabilities for stacking/blending\n   • Consider SMOTE or ADASYN resampling techniques\n   • Experiment with feature selection (top 15 features)\n   • Try advanced ensemble methods (XGBoost, CatBoost)\n   • Implement threshold tuning for minority classes\n   • Consider cost-sensitive learning approaches\n\"\"\")\n\n