ts_summary['skew'] = train_df[numeric_cols].skew()\nstats_summary['kurtosis'] = train_df[numeric_cols].kurtosis()\nstats_summary['missing'] = train_df[numeric_cols].isnull().sum()\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DESCRIPTIVE STATISTICS\")\nprint(\"=\" * 80)\ndisplay(stats_summary.round(4))\n\n# Create visualization grid for numerical features\nfig, axes = plt.subplots(3, 4, figsize=(20, 15))\naxes = axes.flatten()\n\n# Blue + Orange color scheme\nfor idx, col in enumerate(numeric_cols[:12]):  # Limit to first 12 features\n    # Histogram with KDE\n    axes[idx].hist(train_df[col], bins=50, color='#3498db', alpha=0.7, edgecolor='#2c3e50', linewidth=0.5, density=True)\n    train_df[col].plot(kind='kde', ax=axes[idx], color='#e67e22', linewidth=2.5)\n    axes[idx].set_title(f'{col}\\n(Skewness: {train_df[col].skew():.2f})', fontsize=10, fontweight='bold', color='#1a5276')\n    axes[idx].set_xlabel(col, fontsize=10, fontweight='bold')\n    axes[idx].set_ylabel('Density', fontsize=10, fontweight='bold')\n    axes[idx].grid(alpha=0.25, linestyle='--', linewidth=0.5)\n    \n    # Add mean and median lines\n    mean_val = train_df[col].mean()\n    median_val = train_df[col].median()\n    axes[idx].axvline(mean_val, color='#2980b9', linestyle='--', linewidth=1.8, label=f'Mean: {mean_val:.2f}')\n    axes[idx].axvline(median_val, color='#e67e22', linestyle='--', linewidth=1.8, label=f'Median: {median_val:.2f}')\n    axes[idx].legend(fontsize=8, frameon=True, fancybox=True)\n\n# Remove empty subplot if less than 12 features\nif len(numeric_cols) < 12:\n    for idx in range(len(numeric_cols), 12):\n        fig.delaxes(axes[idx])\n\nplt.suptitle('Numerical Features Distribution Analysis', fontsize=16, fontweight='bold', y=1.02, color='#1a5276')\nplt.tight_layout()\nplt.show()\n\n# Boxplot for outlier detection - Only show non-empty groups\nprint(\"\\n\" + \"=\" * 80)\nprint(\"OUTLIER DETECTION - BOXPLOT ANALYSIS\")\nprint(\"=\" * 80)\n\n# Group features by scale for better