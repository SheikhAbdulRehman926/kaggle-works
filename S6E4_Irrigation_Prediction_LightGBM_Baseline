dient = plt.cm.Blues(np.linspace(0.4, 0.9, len(class_dist)))\norange_gradient = plt.cm.Oranges(np.linspace(0.4, 0.9, len(class_dist)))\n\n# Create advanced visualization with 6 subplots in 2x3 grid\nfig = plt.figure(figsize=(22, 12))\ngs = fig.add_gridspec(2, 3, height_ratios=[1, 1], hspace=0.35, wspace=0.3)\n\n# 1. Bar plot with count values (top-left) - Blue + Orange Gradient\nax1 = fig.add_subplot(gs[0, 0])\ncolors_bar = ['#2980b9', '#e67e22', '#f39c12']  # Blue, Orange, Light Orange\nbars = ax1.bar(class_dist.index, class_dist.values, color=colors_bar, \n               edgecolor='#2c3e50', linewidth=1.8, alpha=0.9, width=0.6)\nax1.set_xlabel('Irrigation Need', fontsize=13, fontweight='bold', color='#2c3e50')\nax1.set_ylabel('Count', fontsize=13, fontweight='bold', color='#2c3e50')\nax1.set_title('Absolute Class Distribution', fontsize=14, fontweight='bold', pad=15, color='#1a5276')\nax1.grid(axis='y', alpha=0.25, linestyle='--', linewidth=0.8, color='#7f8c8d')\nax1.tick_params(axis='both', labelsize=11)\n\n# Add value labels on bars with better positioning\nfor bar, count, pct in zip(bars, class_dist.values, class_pct):\n    height = bar.get_height()\n    ax1.text(bar.get_x() + bar.get_width()/2., height + 2500,\n             f'{count:,}\\n({pct}%)', ha='center', va='bottom', \n             fontweight='bold', fontsize=10, color='#2c3e50')\n\n# 2. Enhanced pie chart with professional styling (top-middle)\nax2 = fig.add_subplot(gs[0, 1])\nwedges, texts, autotexts = ax2.pie(class_dist.values, \n                                    labels=class_dist.index,\n                                    autopct='%1.1f%%', \n                                    colors=colors_bar,\n                                    startangle=90,\n                                    explode=(0.03, 0.03, 0.06),\n                                    shadow=True,\n                                    textprops={'fontweight': 'bold', 'fontsize': 12})\nfor autotext in autotexts:\n    autotext.set_color('white')\n    autotext.set_fontweight('bold')\n    autotext.set_fontsize(13)\nfor text in texts:\n    text.set_color('#2c3e50')\n    text.set_fontweight('bold')\n    text.set_fontsize(11)\nax2.set_title('Percentage Distribution', fontsize=14, fontweight='bold', pad=15, color='#1a5276')\n\n# 3. Donut chart with enhanced styling (top-right)\nax3 = fig.add_subplot(gs[0, 2])\nwedges, texts, autotexts = ax3.pie(class_dist.values, \n                                    autopct='%1.1f%%',\n                                    colors=colors_bar,\n                                    startangle=90,\n                                    pctdistance=0.85,\n                                    wedgeprops=dict(width=0.35, edgecolor='white', linewidth=2))\nax3.set_title('Class Imbalance Donut Chart', fontsize=14, fontweight='bold', pad=15, color='#1a5276')\n\n# Add legend\nax3.legend(wedges, class_dist.index, title=\"Classes\", \n           loc=\"center left\", bbox_to_anchor=(1.05, 0, 0.5, 1), \n           fontsize=10, title_fontsize=11, frameon=True, fancybox=True, shadow=True)\n\nfor autotext in autotexts:\n    autotext.set_color('#2c3e50')\n    autotext.set_fontweight('bold')\n    autotext.set_fontsize(12)\n\n# 4. Horizontal bar chart with gradient (bottom-left) - Orange Gradient\nax4 = fig.add_subplot(gs[1, 0])\ny_pos = np.arange(len(class_dist))\nbars_h = ax4.barh(y_pos, class_dist.values, color=colors_bar[::-1], \n                  edgecolor='#2c3e50', linewidth=1.5, alpha=0.9, height=0.6)\nax4.set_yticks(y_pos)\nax4.set_yticklabels(class_dist.index, fontsize=12, fontweight='bold')\nax4.set_xlabel('Count', fontsize=13, fontweight='bold', color='#2c3e50')\nax4.set_title('Class Distribution (Horizontal View)', fontsize=14, fontweight='bold', pad=15, color='#1a5276')\nax4.grid(axis='x', alpha=0.25, linestyle='--', linewidth=0.8, color='#7f8c8d')\nax4.tick_params(axis='x', labelsize=11)\n\n# Add value labels\nfor i, (cls, count, pct) in enumerate(zip(class_dist.index, class_dist.values, class_pct)):\n    ax4.text(count + 6000, i, f'{count:,} ({pct}%)', \n             va='center', fontweight='bold', fontsize=11, color='#2c3e50')\n\n# 5. Stacked proportional bar chart (bottom-middle) - Blue + Orange\nax5 = fig.add_subplot(gs[1, 1])\ntotal = class_dist.sum()\ncumulative = 0\n\nfor i, (cls, count, color) in enumerate(zip(class_dist.index, class_dist.values, colors_bar)):\n    width = (count / total) * 100\n    bar = ax5.barh(0, width, left=cumulative, color=color, \n                   edgecolor='white', linewidth=2.5, height=0.65, alpha=0.9)\n    ax5.text(cumulative + width/2, 0, f'{cls}\\n{count:,}\\n({width:.1f}%)', \n             ha='center', va='center', fontweight='bold', fontsize=11, \n             color='white', fontfamily='sans-serif')\n    cumulative += width\n\nax5.set_xlim(0, 100)\nax5.set_ylim(-0.6, 0.6)\nax5.set_xlabel('Percentage of Total (%)', fontsize=13, fontweight='bold', color='#2c3e50')\nax5.set_title('Proportional Class Distribution', fontsize=14, fontweight='bold', pad=15, color='#1a5276')\nax5.set_yticks([])\nax5.grid(axis='x', alpha=0.25, linestyle='--', linewidth=0.8, color='#7f8c8d')\n\n# 6. Cumulative distribution with enhanced styling (bottom-right) - Orange Theme\nax6 = fig.add_subplot(gs[1, 2])\ncumulative_pct = np.cumsum(class_pct.values)\nx_pos = range(len(class_dist))\n\n# Create smooth curve with orange theme\nax6.plot(x_pos, cumulative_pct, marker='o', linewidth=3, \n         markersize=10, color='#e67e22', markerfacecolor='#d35400', \n         markeredgecolor='white', markeredgewidth=2, label='Cumulative %')\nax6.fill_between(x_pos, cumulative_pct, alpha=0.3, color='#f39c12')\nax6.set_xticks(x_pos)\nax6.set_xticklabels(class_dist.index, fontsize=12, fontweight='bold')\nax6.set_ylabel('Cumulative Percentage (%)', fontsize=13, fontweight='bold', color='#2c3e50')\nax6.set_xlabel('Class', fontsize=13, fontweight='bold', color='#2c3e50')\nax6.set_title('Cumulative Distribution Analysis', fontsize=14, fontweight='bold', pad=15, color='#1a5276')\nax6.set_ylim(0, 105)\nax6.grid(alpha=0.25, linestyle='--', linewidth=0.8, color='#7f8c8d')\nax6.legend(loc='lower right', fontsize=10, frameon=True, fancybox=True)\n\n# Add value labels on points with better positioning\nfor i, (cls, cum_pct) in enumerate(zip(class_dist.index, cumulative_pct)):\n    offset = 2 if i < 2 else -3\n    ax6.text(i, cum_pct + offset, f'{cum_pct:.1f}%', \n             ha='center', fontweight='bold', fontsize=10, \n             color='#d35400', bbox=dict(boxstyle=\"round,pad=0.3\", facecolor='white', alpha=0.7))\n\n# Main title with professional styling\nfig.suptitle('S6E4: Irrigation Need - Comprehensive Target Distribution Analysis', \n             fontsize=18, fontweight='bold', y=1.02, color='#1a5276')\n\n# Add subtle background color\nfig.patch.set_facecolor('#f8f9fa')\nplt.tight_layout()\nplt.show()\n\n# Print summary statistics with professional formatting\nprint(\"\\n\" + \"=\" * 80)\nprint(\"📊 SUMMARY INSIGHTS\")\nprint(\"=\" * 80)\n\n# Create styled summary table\ninsights_data = {\n    'Metric': ['📌 Number of Classes', '👑 Majority Class', '⚠️ Minority Class', \n               '⚖️ Imbalance Ratio', '📈 Imbalance Severity', '📊 Total Samples'],\n    'Value': [len(class_dist), 'Low', 'High', f'{imbalance_ratio:.2f}x', \n              'Severe' if imbalance_ratio > 10 else 'Moderate', f'{len(train_df):,}']\n}\n\ninsights_df = pd.DataFrame(insights_data)\ndisplay(insights_df)\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"🎯 KEY FINDINGS & RECOMMENDATIONS\")\nprint(\"=\" * 80)\nprint(f\"\\n📌 CLASS IMBALANCE ANALYSIS:\")\nprint(f\"  • The target variable has {len(class_dist)} classes with significant imbalance\")\nprint(f\"  • 'Low' class dominates with {class_pct[0]:.1f}% ({class_dist.iloc[0]:,} samples)\")\nprint(f\"  • 'High' class is severely underrepresented with only {class_pct[2]:.1f}% ({class_dist.iloc[2]:,} samples)\")\nprint(f\"  • Imbalance ratio of {imbalance_ratio:.2f}x indicates the need for special handling\")\n\nprint(f\"\\n💡 RECOMMENDED APPROACHES:\")\nrecommendations = [\n    \"Use class_weight='balanced' in model training\",\n    \"Apply stratified cross-validation techniques\",\n    \"Consider SMOTE or ADASYN resampling methods\",\n    \"Use balanced accuracy as evaluation metric\",\n    \"Implement ensemble methods with focus on minority class\",\n    \"Consider cost-sensitive learning approaches\"\n]\n\nfor i, rec in enumerate(recommendations, 1):\n    print(f\"  {i}. {rec}\")\n\nprint(f\"\\n📊 VISUALIZATION INSIGHTS:\")\nprint(f\"  • Blue represents majority class (Low) - {class_pct[0]:.1f}% of samples\")\nprint(f\"  • Orange represents minority classes (Medium & High)\")\nprint(f\"  • The donut chart clearly shows the proportion of each class\")\nprint(f\"  • Cumulative distribution shows sharp increase after Low class\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"✅ Target Analysis Complete\")\nprint(\"=\" * 80)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-01T09:22:43.67708Z","iopub.execute_input":"2026-04-01T09:22:43.677532Z","iopub.status.idle":"2026-04-01T09:22:44.53771Z","shell.execute_reply.started":"2026-04-01T09:22:43.677501Z","shell.execute_reply":"2026-04-01T09:22:44.536628Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nTARGET VARIABLE DISTRIBUTION\n================================================================================\n\nClass        Count        Percentage   Status         \n--------------------------------------------------------------------------------\nHigh         21,009       3.33        % Majority       \nLow          369,917      58.72       % Middle         \nMedium       239,074      37.95       % Minority       \n\n--------------------------------------------------------------------------------\nIMBALANCE METRICS:\n  • Majority Class Count: 369,917\n  • Minority Class Count: 21,009\n  • Imbalance Ratio: 17.61x\n  • Imbalance Sev