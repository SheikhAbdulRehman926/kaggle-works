ext'\n    return 'Mixed/Other'\n\ntrain['puzzle_type']  = train['prompt'].apply(classify_puzzle)\ntrain['answer_type']  = train['answer'].astype(str).apply(classify_answer)\ntrain['prompt_len']   = train['prompt'].astype(str).apply(len)\ntrain['answer_len']   = train['answer'].astype(str).apply(len)\ntrain['word_count']   = train['prompt'].astype(str).apply(lambda x: len(x.split()))\ntrain['example_count']= train['prompt'].astype(str).apply(\n    lambda x: len(re.findall(r'→|->|=>', x))\n)\n\ntest['puzzle_type']   = test['prompt'].apply(classify_puzzle)\ntest['prompt_len']    = test['prompt'].astype(str).apply(len)\ntest['word_count']    = test['prompt'].astype(str).apply(lambda x: len(x.split()))\n\nprint(train[['puzzle_type','answer_type','prompt_len','answer_len','word_count','example_count']].describe())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-29T18:45:21.502636Z","iopub.execute_input":"2026-03-29T18:45:21.503242Z","iopub.status.idle":"2026-03-29T18:45:21.666074Z","shell.execute_reply.started":"2026-03-29T18:45:21.503183Z","shell.execute_reply":"2026-03-29T18:45:21.66462Z"}},"outputs":[{"name":"stdout","text":"        prompt_len   answer_len   word_count  example_count\ncount  9500.000000  9500.000000  9500.000000    9500.000000\nmean    301.515895     8.393789    50.042947       2.926947\nstd     104.265311     8.035097    14.305601       3.512738\nmin     177.000000     1.000000    32.000000       0.000000\n25%     209.000000     4.000000    36.000000       0.000000\n50%     281.000000     5.000000    46.000000       3.000000\n75%     371.000000     8.000000    65.000000       5.000000\nmax     510.000000    39.000000    78.000000      11.000000\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"fig, axes = plt.subplots(1, 4, figsize=(16, 3))\nfig.patch.set_facecolor('#0d0d0d')\n\nmetrics = [\n    (\"Train Rows\",    f\"{len(train):,}\",   \"labeled puzzles\",         '#7F77DD'),\n    (\"Test Rows\",   